# Copy to .env and fill in. .env is gitignored.

# Optional: your Sleeper league ID (the number in your league's URL on sleeper.com).
# When set, the engine pulls that league's live scoring settings.
# Leave blank to use the bundled default scoring in data/default_league_scoring.json
# (12-team superflex, full PPR), which is what the published results were built on.
SLEEPER_LEAGUE_ID=
